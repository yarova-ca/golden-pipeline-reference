{
	admin off
	auto_https off
}

# Application port
:2015 {
	encode gzip

	# If a gateway serves this app under a path prefix, strip it here.
	# The default is a sentinel that can never match a real request path.
	# NEVER set BASE_URL to an empty string: `uri strip_prefix` with no
	# argument is a Caddyfile parse error and the container will not start.
	uri strip_prefix {$BASE_URL:/__no_prefix__}

	@api path /api/* /hc
	handle @api {
		reverse_proxy {$API_URL:http://127.0.0.1:8080}
	}

	handle {
		root * /site
		try_files {path} /index.html
		file_server
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
	}
}

# Health port - what the platform probe hits. Kept separate from :2015 so a
# broken app bundle cannot make the probe pass, and a path prefix cannot make
# the probe fail.
:2016 {
	respond 200
}
